{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/lively-photos-director/brief.schema.json",
  "title": "Lively Photos Brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["idea"],
  "properties": {
    "idea": {"type": "string", "minLength": 1},
    "operation": {
      "enum": ["generate_new_scene", "edit_existing_image", "repair_generated_image", "create_series", "audit_only", "compile_only"]
    },
    "reference_images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset", "roles"],
            "properties": {
              "asset": {"type": "string", "minLength": 1},
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["identity", "wardrobe", "product_or_prop", "environment", "composition", "lighting", "style", "background"]
                }
              },
              "strength": {"enum": ["strong", "usable", "weak", "conflicting", "multiple-role"]},
              "preserve": {"type": "array", "items": {"type": "string"}},
              "may_change": {"type": "array", "items": {"type": "string"}}
            }
          }
        ]
      }
    },
    "intended_use": {"type": "string"},
    "scene_mode": {
      "enum": ["documentary-corporate", "candid-professional", "editorial-natural", "everyday-lifestyle", "event-documentary"]
    },
    "capture_profile": {
      "enum": ["phone-candid", "documentary-camera", "editorial-camera", "controlled-professional"]
    },
    "subject_scale": {
      "enum": ["close-portrait", "medium", "three-quarter", "full-body", "environmental", "distant-candid"]
    },
    "must_include": {"type": "array", "items": {"type": "string"}},
    "must_avoid": {"type": "array", "items": {"type": "string"}},
    "aspect_ratio": {"type": "string"},
    "target_engine": {"type": "string"},
    "target_model": {"type": "string"},
    "output_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quality": {"type": "string"},
        "size": {"type": "string"},
        "background": {"type": "string"},
        "output_format": {"type": "string"},
        "compression": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
